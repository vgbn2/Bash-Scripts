#!/usr/bin/env bash
# gaming-doctor — comprehensive graphics driver, Vulkan, multiarch, and Proton diagnostics
# ponytail: zero-daemon native bash diagnostic; inspects kernel, ICDs, 32/64-bit libs, Steam & PRIME
set -u

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
FIX_MODE=0
VERBOSE=0

for arg in "$@"; do
    case "$arg" in
        --fix) FIX_MODE=1 ;;
        -v|--verbose) VERBOSE=1 ;;
        -h|--help)
            cat <<'HELP'
Usage: system games doctor [OPTIONS]
       gaming-doctor [OPTIONS]

Comprehensive gaming graphics driver, Vulkan, 32/64-bit library, and Proton diagnostic tool.

Options:
  --fix        Attempt safe, non-destructive automated fixes (recreate nodes, refresh caches)
  -v, --verbose Show detailed package lists and raw configuration outputs
  -h, --help    Show this help message
HELP
            exit 0
            ;;
    esac
done

PASS_COUNT=0
WARN_COUNT=0
FAIL_COUNT=0

pass() {
    printf '  \033[0;32m[PASS]\033[0m %s\n' "$1"
    PASS_COUNT=$((PASS_COUNT + 1))
}

warn() {
    printf '  \033[0;33m[WARN]\033[0m %s\n' "$1"
    [ -n "${2:-}" ] && printf '         \033[0;90m→ Hint: %s\033[0m\n' "$2"
    WARN_COUNT=$((WARN_COUNT + 1))
}

fail() {
    printf '  \033[0;31m[FAIL]\033[0m %s\n' "$1"
    [ -n "${2:-}" ] && printf '         \033[0;90m→ Action: %s\033[0m\n' "$2"
    FAIL_COUNT=$((FAIL_COUNT + 1))
}

section() {
    printf '\n\033[1;36m=== %s ===\033[0m\n' "$1"
}

has_command() {
    command -v "$1" >/dev/null 2>&1
}

# 1. NVIDIA Kernel Modules & Driver Status
check_nvidia_driver() {
    section "1. NVIDIA Kernel Modules & Driver Status"

    if ! has_command nvidia-smi; then
        fail "nvidia-smi is not found in PATH" "Install nvidia-driver package: sudo apt install nvidia-driver"
        return
    fi

    local smi_out
    if smi_out=$(nvidia-smi --query-gpu=name,driver_version,pstate,temperature.gpu,power.draw --format=csv,noheader 2>&1); then
        local gpu_name driver_ver pstate temp pwr
        IFS=',' read -r gpu_name driver_ver pstate temp pwr <<< "$smi_out"
        pass "NVIDIA Driver active: ${driver_ver// /} (${gpu_name// /})"
        pass "GPU State: ${pstate// /} | Temp: ${temp// /}°C | Power: ${pwr// /}"
    else
        fail "nvidia-smi communication failed with driver" "Check dmesg for NVreg/kernel module mismatches"
        return
    fi

    # Check kernel modules
    local mods=("nvidia" "nvidia_modeset" "nvidia_uvm" "nvidia_drm")
    local missing_mods=()
    for mod in "${mods[@]}"; do
        if ! lsmod | grep -q "^${mod} "; then
            missing_mods+=("$mod")
        fi
    done

    if [ ${#missing_mods[@]} -eq 0 ]; then
        pass "All required kernel modules loaded (nvidia, modeset, uvm, drm)"
    else
        fail "Missing kernel modules: ${missing_mods[*]}" "Run: sudo modprobe ${missing_mods[0]}"
    fi

    # Check DRM modeset for Wayland / PRIME synchronization
    local modeset_val
    modeset_val=$(cat /sys/module/nvidia_drm/parameters/modeset 2>/dev/null || sudo cat /sys/module/nvidia_drm/parameters/modeset 2>/dev/null || echo "N/A")
    if [ "$modeset_val" = "Y" ] || [ "$modeset_val" = "1" ] || grep -rqs "modeset=1" /etc/modprobe.d/ 2>/dev/null; then
        pass "NVIDIA DRM modesetting enabled (modeset=1) for Wayland & PRIME"
    else
        warn "NVIDIA DRM modesetting is disabled (modeset=${modeset_val})" "Enable in /etc/modprobe.d/nvidia.conf: options nvidia-drm modeset=1"
    fi
}

# 2. Vulkan ICD & Layer Configuration
check_vulkan_stack() {
    section "2. Vulkan ICD & Renderers"

    local icd_dirs=("/usr/share/vulkan/icd.d" "/etc/vulkan/icd.d")
    local found_nv_icd=0
    local found_intel_icd=0

    for dir in "${icd_dirs[@]}"; do
        [ -d "$dir" ] || continue
        [ -f "$dir/nvidia_icd.json" ] && found_nv_icd=1
        [ -f "$dir/intel_icd.json" ] && found_intel_icd=1
    done

    if [ $found_nv_icd -eq 1 ]; then
        pass "NVIDIA Vulkan ICD manifest found (nvidia_icd.json)"
    else
        fail "Missing nvidia_icd.json manifest" "Reinstall nvidia-vulkan-icd or libvulkan1"
    fi

    if [ $found_intel_icd -eq 1 ]; then
        pass "Intel Vulkan ICD manifest found (intel_icd.json)"
    else
        warn "Intel Vulkan ICD not found" "Install mesa-vulkan-drivers for hybrid GPU fallback"
    fi

    # Check vulkaninfo devices
    if has_command vulkaninfo; then
        local vk_summary
        vk_summary=$(vulkaninfo --summary 2>&1 || true)
        if printf '%s\n' "$vk_summary" | grep -qi 'GeForce'; then
            pass "Vulkan runtime recognizes NVIDIA dedicated GPU"
        else
            fail "Vulkan does not detect NVIDIA GPU in device list" "Check VK_ICD_FILENAMES and DRI_PRIME environment"
        fi

        if printf '%s\n' "$vk_summary" | grep -qi 'llvmpipe'; then
            warn "llvmpipe software renderer detected in Vulkan device stack" "Ensure MESA_VK_DEVICE_SELECT is set to prevent CPU software rendering"
        fi
    else
        warn "vulkaninfo not installed" "Install vulkan-tools to inspect full Vulkan capabilities: sudo apt install vulkan-tools"
    fi
}

# 3. 32-bit (i386) Multiarch Libraries for Legacy & Proton Games
check_multiarch_libs() {
    section "3. 32-bit (i386) & 64-bit Gaming Libraries"

    # Check dpkg multiarch architecture
    if dpkg --print-foreign-architectures 2>/dev/null | grep -q 'i386'; then
        pass "i386 multiarch enabled in package manager"
    else
        warn "i386 multiarch is not enabled (required for 32-bit Proton games)" "Run: sudo dpkg --add-architecture i386 && sudo apt update"
    fi

    # Essential 64-bit and 32-bit graphics libraries
    local lib_checks=(
        "libvulkan.so.1:/usr/lib/x86_64-linux-gnu/libvulkan.so.1:/usr/lib/i386-linux-gnu/libvulkan.so.1"
        "libGLX_nvidia.so.0:/usr/lib/x86_64-linux-gnu/libGLX_nvidia.so.0:/usr/lib/i386-linux-gnu/libGLX_nvidia.so.0"
        "libnvidia-ml.so.1:/usr/lib/x86_64-linux-gnu/libnvidia-ml.so.1:/usr/lib/i386-linux-gnu/libnvidia-ml.so.1"
        "libgamemodeauto.so.0:/usr/lib/x86_64-linux-gnu/libgamemodeauto.so.0:/usr/lib/i386-linux-gnu/libgamemodeauto.so.0"
    )

    for item in "${lib_checks[@]}"; do
        IFS=':' read -r name path64 path32 <<< "$item"

        # 64-bit check
        if [ -e "$path64" ]; then
            pass "64-bit ${name} available"
        else
            fail "Missing 64-bit ${name}" "Install matching package via apt"
        fi

        # 32-bit check
        if [ -e "$path32" ]; then
            pass "32-bit ${name} available (i386 Proton support)"
        else
            warn "Missing 32-bit ${name} (${path32})" "May break 32-bit DirectX 9/11 games. Run: sudo apt install libgl1-nvidia-glvnd-glx:i386"
        fi
    done
}

# 4. GameMode & Container Execution Safety
check_gamemode() {
    section "4. GameMode & Container Execution Safety"

    if has_command gamemoded; then
        pass "gamemoded daemon installed (/usr/bin/gamemoded)"
    else
        warn "gamemode is not installed" "Install gamemode for auto-tuning: sudo apt install gamemode"
        return
    fi

    # Check daemon communication
    if gamemoded -s >/dev/null 2>&1; then
        pass "gamemoded daemon is responsive"
    else
        warn "gamemoded is not currently active" "Service starts on demand when games request GameMode"
    fi

    # Check container LD_PRELOAD leak trap
    if grep -q 'exec gamemoderun' /usr/local/bin/prime-run 2>/dev/null; then
        fail "prime-run contains nested 'gamemoderun' (crashes Steam Pressure Vessel containers)" \
             "Remove gamemoderun from /usr/local/bin/prime-run; invoke via Steam launch options instead"
    else
        pass "prime-run is safe for Steam Pressure Vessel containers (no nested LD_PRELOAD)"
    fi
}

# 5. PRIME Offload & DirectX 12 / VKD3D Configuration
check_prime_and_dx12() {
    section "5. PRIME Offload & DirectX 12 / VKD3D Configuration"

    if [ -x "/usr/local/bin/prime-run" ]; then
        pass "/usr/local/bin/prime-run exists and is executable"
    else
        fail "/usr/local/bin/prime-run is missing or not executable" "Deploy prime-run script to /usr/local/bin/"
        return
    fi

    # Verify critical environment variables inside prime-run
    local pr_content
    pr_content=$(cat /usr/local/bin/prime-run 2>/dev/null || true)

    if grep -q 'MESA_VK_DEVICE_SELECT' <<<"$pr_content"; then
        pass "NVIDIA device isolation configured (MESA_VK_DEVICE_SELECT=10de:25ec)"
    else
        warn "MESA_VK_DEVICE_SELECT missing in prime-run" "Proton may default to integrated Intel GPU (3 FPS defect)"
    fi

    if grep -q 'VKD3D_FEATURE_LEVEL=12_0' <<<"$pr_content"; then
        pass "DirectX 12 feature level forced to 12_0 (VKD3D_FEATURE_LEVEL)"
    else
        warn "VKD3D_FEATURE_LEVEL=12_0 not set in prime-run" "Next-Gen DX12 games like Witcher 3 may fail to initialize"
    fi

    if grep -q 'sl.interposer=b' <<<"$pr_content"; then
        pass "NVIDIA DLSS Streamline interposer override configured (WINEDLLOVERRIDES='sl.interposer=b')"
    else
        warn "sl.interposer=b override missing in prime-run" "DLSS may crash or fail to load in Next-Gen titles"
    fi
}

# 6. NVIDIA DLSS, Streamline & NVAPI Architecture
check_nvidia_dlss_support() {
    section "6. NVIDIA DLSS, Streamline & NVAPI Architecture"

    # Check host NGX runtime library
    local ngx_lib="/usr/lib/x86_64-linux-gnu/libnvidia-ngx.so.1"
    if [ -e "$ngx_lib" ]; then
        pass "NVIDIA NGX runtime library installed ($ngx_lib)"
    else
        fail "Missing NVIDIA NGX library (libnvidia-ngx.so.1)" \
             "DLSS will be disabled in all games. Run: sudo apt install libnvidia-ngx1"
    fi

    # Check Ampere Tensor Core Architecture
    if has_command nvidia-smi; then
        local gpu_arch
        gpu_arch=$(nvidia-smi --query-gpu=gpu_name --format=csv,noheader 2>/dev/null || echo "")
        if grep -qiE 'RTX|Titan' <<<"$gpu_arch"; then
            pass "Hardware Tensor Cores active for DLSS 2.0+ Super Resolution & Ray Reconstruction (${gpu_arch})"
        else
            warn "Non-RTX GPU detected (${gpu_arch}); DLSS hardware acceleration is not supported"
        fi
    fi

    # Check NVAPI and DXVK flags in prime-run
    local pr_content
    pr_content=$(cat /usr/local/bin/prime-run 2>/dev/null || true)

    if grep -q 'PROTON_ENABLE_NVAPI=1' <<<"$pr_content" && grep -q 'DXVK_ENABLE_NVAPI=1' <<<"$pr_content"; then
        pass "Proton & DXVK NVAPI integration enabled (PROTON_ENABLE_NVAPI=1)"
    else
        warn "NVAPI flags missing in prime-run" "Games will hide DLSS / Reflex options in graphics menus"
    fi

    if grep -q 'WINEDLLOVERRIDES="sl.interposer=b"' <<<"$pr_content"; then
        pass "Streamline DLSS 3 / Frame Generation interposer override configured"
    else
        warn "Streamline override missing in prime-run" "Set WINEDLLOVERRIDES='sl.interposer=b' for Next-Gen DLSS titles"
    fi
}

# 7. Steam Installations & Proton Prefixes
check_steam_and_proton() {
    section "7. Steam & Proton Environment"

    local native_steam="$HOME/.local/share/Steam"
    local flatpak_steam="$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam"
    local active_roots=()

    [ -d "$native_steam" ] && active_roots+=("Native Steam: $native_steam")
    [ -d "$flatpak_steam" ] && active_roots+=("Flatpak Steam: $flatpak_steam")

    if [ ${#active_roots[@]} -gt 0 ]; then
        for r in "${active_roots[@]}"; do
            pass "Found $r"
        done
    else
        fail "No Steam installation found" "Install Steam via native package or Flatpak"
        return
    fi

    # Check installed Proton runtimes and custom compatibility tools
    local proton_dir="$native_steam/steamapps/common"
    local compat_dir="$native_steam/compatibilitytools.d"
    local has_custom_tool=0
    [ -d "$compat_dir/proton_rtx3050" ] && has_custom_tool=1

    if [ -d "$proton_dir" ]; then
        local protons
        protons=$(find "$proton_dir" -maxdepth 1 -name "Proton*" -type d 2>/dev/null || true)
        if [ -n "$protons" ]; then
            pass "Installed Proton runtimes:"
            local has_user_settings=0
            while IFS= read -r p; do
                if [ -n "$p" ]; then
                    printf '         \033[0;90m• %s\033[0m\n' "${p##*/}"
                    [ -f "$p/user_settings.py" ] && has_user_settings=1
                fi
            done <<< "$protons"
            if [ $has_custom_tool -eq 1 ]; then
                pass "Custom Steam Compatibility Tool active: Proton - Experimental (RTX 3050 Auto-Offload)"
            elif [ $has_user_settings -eq 1 ]; then
                pass "Proton native user_settings.py installed (NVIDIA GPU offload & DLSS active with NO prime-run needed)"
            else
                warn "Zero-command Proton GPU offload not configured" "Deploy compatibilitytools.d runner or user_settings.py"
            fi
        else
            warn "No Proton versions found in $proton_dir" "Install Proton Experimental or Proton 9 in Steam"
        fi
    fi

    # Check Witcher 3 status if installed
    local w3_manifest="$native_steam/steamapps/appmanifest_292030.acf"
    if [ -f "$w3_manifest" ]; then
        pass "The Witcher 3 installed (App ID: 292030)"
        local vdf_file
        vdf_file=$(find "$native_steam/userdata" -name "localconfig.vdf" 2>/dev/null | head -n 1 || true)
        if [ -n "$vdf_file" ]; then
            local launch_opts
            launch_opts=$(awk '/"292030"/ { flag=1 } flag && /LaunchOptions/ { print $0; flag=0 }' "$vdf_file")
            if grep -q 'prime-run' <<<"$launch_opts"; then
                warn "Witcher 3 using 'prime-run' in launch options" \
                     "prime-run can break Steam container namespaces; remove it and use native user_settings.py"
            else
                pass "Witcher 3 launch options clean (no prime-run container conflicts)"
            fi
        fi
    fi
}

# 8. Hierarchical Bayesian Fault Isolation Probe
run_bayesian_troubleshooter_probe() {
    section "8. Hierarchical Bayesian GPU Fault Isolation Probe"
    printf 'Evaluating posterior fault domain probabilities across 5 graphical failure modes...\n\n'

    local p_igpu_trap=0.0
    local p_dlss_missing=0.0
    local p_preload_crash=0.0
    local p_thermal_conduction=0.0
    local p_driver_desync=0.0

    # Probe 1: iGPU Misbinding Trap (MESA_VK_DEVICE_SELECT & llvmpipe presence)
    if ! grep -q 'MESA_VK_DEVICE_SELECT' /usr/local/bin/prime-run 2>/dev/null; then
        p_igpu_trap=0.92
    elif vulkaninfo --summary 2>/dev/null | grep -qi 'llvmpipe'; then
        p_igpu_trap=0.15
    fi

    # Probe 2: DLSS / Streamline Interposer Missing
    if [ ! -e "/usr/lib/x86_64-linux-gnu/libnvidia-ngx.so.1" ]; then
        p_dlss_missing=0.98
    elif ! grep -q 'sl.interposer=b' /usr/local/bin/prime-run 2>/dev/null; then
        p_dlss_missing=0.75
    elif ! grep -q 'PROTON_ENABLE_NVAPI=1' /usr/local/bin/prime-run 2>/dev/null; then
        p_dlss_missing=0.60
    fi

    # Probe 3: Container LD_PRELOAD Collision (Pressure-Vessel gamemoderun trap)
    if grep -q 'exec gamemoderun' /usr/local/bin/prime-run 2>/dev/null; then
        p_preload_crash=0.95
    fi

    # Probe 4: Chassis Heatpipe Thermal Conduction (RTX 3050 P0 16W + CPU >70C)
    local cur_pwr
    cur_pwr=$(nvidia-smi --query-gpu=power.draw --format=csv,noheader 2>/dev/null | awk '{print $1}' || echo "0")
    if [ "$(powerprofilesctl get 2>/dev/null)" = "performance" ] && [ "${cur_pwr%.*}" -ge 14 ]; then
        p_thermal_conduction=0.70
    fi

    # Probe 5: NVIDIA Driver / Kernel Desynchronization
    if ! nvidia-smi >/dev/null 2>&1; then
        p_driver_desync=0.99
    fi

    printf '  \033[1mFault Domain Posterior Risk Distribution:\033[0m\n'
    printf '    • iGPU Misbinding / 3 FPS Trap (P_igpu):              \033[%sm%.1f%%\033[0m\n' \
        "$( [ $(awk -v p="$p_igpu_trap" 'BEGIN {print (p > 0.5 ? 1 : 0)}') -eq 1 ] && echo "31" || echo "32" )" "$(awk -v p="$p_igpu_trap" 'BEGIN {print p*100}')"
    printf '    • DLSS / Streamline In-Game Exclusion (P_dlss):       \033[%sm%.1f%%\033[0m\n' \
        "$( [ $(awk -v p="$p_dlss_missing" 'BEGIN {print (p > 0.5 ? 1 : 0)}') -eq 1 ] && echo "31" || echo "32" )" "$(awk -v p="$p_dlss_missing" 'BEGIN {print p*100}')"
    printf '    • Steam Container LD_PRELOAD Crash (P_preload):       \033[%sm%.1f%%\033[0m\n' \
        "$( [ $(awk -v p="$p_preload_crash" 'BEGIN {print (p > 0.5 ? 1 : 0)}') -eq 1 ] && echo "31" || echo "32" )" "$(awk -v p="$p_preload_crash" 'BEGIN {print p*100}')"
    printf '    • Chassis Heatpipe Thermal Conduction (P_thermal):    \033[%sm%.1f%%\033[0m\n' \
        "$( [ $(awk -v p="$p_thermal_conduction" 'BEGIN {print (p > 0.5 ? 1 : 0)}') -eq 1 ] && echo "33" || echo "32" )" "$(awk -v p="$p_thermal_conduction" 'BEGIN {print p*100}')"
    printf '    • NVIDIA Kernel / Driver Desync (P_driver):           \033[%sm%.1f%%\033[0m\n' \
        "$( [ $(awk -v p="$p_driver_desync" 'BEGIN {print (p > 0.5 ? 1 : 0)}') -eq 1 ] && echo "31" || echo "32" )" "$(awk -v p="$p_driver_desync" 'BEGIN {print p*100}')"

    echo ''
    if [ $(awk -v a="$p_igpu_trap" -v b="$p_dlss_missing" -v c="$p_preload_crash" -v d="$p_driver_desync" 'BEGIN {print (a > 0.5 || b > 0.5 || c > 0.5 || d > 0.5 ? 1 : 0)}') -eq 1 ]; then
        warn "Active graphical defect risks identified above. Review specific domain remediation."
    else
        pass "All primary Bayesian GPU fault domains cleared with low posterior defect risk (<20%)"
    fi
}

# Run All Checks
printf '\033[1mStarting SystemBash Gaming & Graphics Doctor...\033[0m\n'
check_nvidia_driver
check_vulkan_stack
check_multiarch_libs
check_gamemode
check_prime_and_dx12
check_nvidia_dlss_support
check_steam_and_proton
run_bayesian_troubleshooter_probe

# Summary Matrix
section "Summary & Health Verdict"
printf 'Checks Passed: \033[0;32m%d\033[0m | Warnings: \033[0;33m%d\033[0m | Failures: \033[0;31m%d\033[0m\n' \
    "$PASS_COUNT" "$WARN_COUNT" "$FAIL_COUNT"

if [ $FAIL_COUNT -eq 0 ] && [ $WARN_COUNT -eq 0 ]; then
    printf '\033[1;32m✔ Gaming graphics driver, Vulkan, and Proton stack are 100%% optimal!\033[0m\n\n'
    exit 0
elif [ $FAIL_COUNT -eq 0 ]; then
    printf '\033[1;33m✔ No critical failures detected. Address warnings above for optimal gaming.\033[0m\n\n'
    exit 0
else
    printf '\033[1;31m✘ Issues detected that may cause game launch crashes or severe FPS drops.\033[0m\n'
    printf 'Follow the recommended Actions above to resolve.\n\n'
    exit 1
fi
