#!/usr/bin/env bash
set -euo pipefail

SYSFS_CPU_DIR="${SYSFS_CPU_DIR:-/sys/devices/system/cpu}"
PROFILE_PATH="${PROFILE_PATH:-/sys/firmware/acpi/platform_profile}"
PROFILE_CHOICES_PATH="${PROFILE_CHOICES_PATH:-/sys/firmware/acpi/platform_profile_choices}"
TURBO_PATH="${TURBO_PATH:-}"

discover_bounds() {
    local min_k="" max_k=""
    if [ -r "${SYSFS_CPU_DIR}/cpu0/cpufreq/cpuinfo_min_freq" ]; then
        min_k=$(cat "${SYSFS_CPU_DIR}/cpu0/cpufreq/cpuinfo_min_freq")
    elif [ -r "${SYSFS_CPU_DIR}/cpufreq/policy0/cpuinfo_min_freq" ]; then
        min_k=$(cat "${SYSFS_CPU_DIR}/cpufreq/policy0/cpuinfo_min_freq")
    fi

    if [ -r "${SYSFS_CPU_DIR}/cpu0/cpufreq/cpuinfo_max_freq" ]; then
        max_k=$(cat "${SYSFS_CPU_DIR}/cpu0/cpufreq/cpuinfo_max_freq")
    elif [ -r "${SYSFS_CPU_DIR}/cpufreq/policy0/cpuinfo_max_freq" ]; then
        max_k=$(cat "${SYSFS_CPU_DIR}/cpufreq/policy0/cpuinfo_max_freq")
    fi

    CPU_MIN_GHZ=$(awk -v k="$min_k" 'BEGIN { if (k ~ /^[0-9]+$/ && k > 0) printf "%.1f", k / 1000000; else printf "0.8"; }')
    CPU_MAX_GHZ=$(awk -v k="$max_k" 'BEGIN { if (k ~ /^[0-9]+$/ && k > 0) printf "%.1f", k / 1000000; else printf "5.0"; }')
}

discover_bounds

usage() {
    cat <<USAGE
usage: cpu <command> [value]

commands:
  status              show profile, CPU cap, current frequency, turbo, temp
  <GHz>               set CPU max frequency (supported: ${CPU_MIN_GHZ}-${CPU_MAX_GHZ} GHz)
  recommend           pick a CPU cap from current temp/load
  cool                low-power profile + min GHz + turbo off
  balanced            balanced profile + recommended CPU cap
  game                performance profile + turbo on + high clock
  full                performance profile + max GHz + turbo on
  profile <name>      set platform profile
  turbo on|off        enable or disable turbo boost
  undervolt [mV]      show or set CPU undervolt offset
USAGE
}

need_sudo_write() {
    local path=$1 value=$2
    if [ ! -e "$path" ]; then
        echo "missing: $path" >&2
        return 1
    fi
    if [ -w "$path" ]; then
        printf '%s\n' "$value" > "$path"
    else
        printf '%s\n' "$value" | sudo tee "$path" >/dev/null
    fi
}

cpu_temp_c() {
    sensors 2>/dev/null | awk '/Package id 0:/ {gsub(/[+°C]/, "", $4); printf "%d", $4; exit}'
}

load_1m() {
    awk '{printf "%.1f", $1}' /proc/loadavg 2>/dev/null || echo "0.0"
}

set_cpu() {
    local input=${1:-}
    local khz

    khz=$(awk -v v="$input" -v min="$CPU_MIN_GHZ" -v max="$CPU_MAX_GHZ" 'BEGIN {
        if (v !~ /^[0-9]+([.][0-9]+)?$/) exit 2;
        if (v > 100) v = v / 1000;
        if (v < min || v > max) exit 3;
        printf "%d", v * 1000000;
    }') || {
        echo "cpu: use a value >= ${CPU_MIN_GHZ} and <= ${CPU_MAX_GHZ} GHz, example: cpu 3.3" >&2
        return 2
    }

    local cpufreq_files
    shopt -s nullglob
    cpufreq_files=("${SYSFS_CPU_DIR}"/cpu*/cpufreq/scaling_max_freq)
    shopt -u nullglob

    if [ ${#cpufreq_files[@]} -eq 0 ]; then
        echo "cpu: CPU frequency scaling is not supported on this system" >&2
        return 1
    fi

    local write_failed=0
    for f in "${cpufreq_files[@]}"; do
        if [ -w "$f" ]; then
            printf '%s\n' "$khz" > "$f" 2>/dev/null || write_failed=1
        elif command -v sudo >/dev/null 2>&1; then
            sudo bash -c 'printf "%s\n" "$1" > "$2"' _ "$khz" "$f" 2>/dev/null || write_failed=1
        else
            write_failed=1
        fi
    done

    if [ "$write_failed" -eq 1 ]; then
        echo "cpu: failed to set frequency ceiling to ${input} GHz" >&2
        return 1
    fi

    echo "CPU max frequency set to ${input} GHz"
}

set_profile() {
    local profile=${1:-}
    local choices

    if [ ! -r "$PROFILE_CHOICES_PATH" ]; then
        echo "platform profile is not available" >&2
        return 1
    fi

    choices=$(cat "$PROFILE_CHOICES_PATH")
    case " $choices " in
        *" $profile "*) need_sudo_write "$PROFILE_PATH" "$profile" ;;
        *)
            echo "invalid profile: $profile" >&2
            echo "choices: $choices" >&2
            return 2
            ;;
    esac
}

get_turbo_path_and_values() {
    # returns: path on_val off_val
    if [ -n "${TURBO_PATH:-}" ] && [ -e "$TURBO_PATH" ]; then
        echo "$TURBO_PATH" 0 1
    elif [ -e "${SYSFS_CPU_DIR}/intel_pstate/no_turbo" ]; then
        echo "${SYSFS_CPU_DIR}/intel_pstate/no_turbo" 0 1
    elif [ -e "${SYSFS_CPU_DIR}/cpufreq/boost" ]; then
        echo "${SYSFS_CPU_DIR}/cpufreq/boost" 1 0
    else
        return 1
    fi
}

get_turbo_state() {
    local t_info
    if t_info=$(get_turbo_path_and_values); then
        local t_path on_v off_v cur_v
        read -r t_path on_v off_v <<< "$t_info"
        cur_v=$(cat "$t_path" 2>/dev/null || echo "")
        if [ "$cur_v" = "$on_v" ]; then
            echo "on"
        elif [ "$cur_v" = "$off_v" ]; then
            echo "off"
        else
            echo "unknown"
        fi
    else
        echo "unsupported"
    fi
}

set_turbo() {
    local action=${1:-}
    local t_info
    if ! t_info=$(get_turbo_path_and_values); then
        echo "cpu: turbo control is not supported on this CPU / governor" >&2
        return 1
    fi

    local t_path on_v off_v write_v
    read -r t_path on_v off_v <<< "$t_info"
    case "$action" in
        on) write_v="$on_v" ;;
        off) write_v="$off_v" ;;
        *) echo "usage: cpu turbo on|off" >&2; return 2 ;;
    esac

    need_sudo_write "$t_path" "$write_v"
    echo "turbo ${action}"
}

recommend_cpu() {
    local temp load target
    temp=$(cpu_temp_c)
    load=$(load_1m)

    if [ -z "$temp" ]; then
        echo "could not read CPU package temp" >&2
        return 1
    fi

    if [ "$temp" -ge 85 ]; then
        target=2.6
    elif [ "$temp" -ge 78 ]; then
        target=3.0
    elif awk -v l="$load" 'BEGIN { exit !(l >= 5.0) }'; then
        target=3.3
    elif [ "$temp" -le 65 ]; then
        target=4.0
    else
        target=3.3
    fi

    # ponytail: clamp target recommendation within discovered hardware limits
    target=$(awk -v t="$target" -v min="$CPU_MIN_GHZ" -v max="$CPU_MAX_GHZ" 'BEGIN {
        if (t < min) t = min;
        if (t > max) t = max;
        printf "%.1f", t;
    }')

    echo "temp=${temp}C load=${load} -> cpu ${target}"
    set_cpu "$target"
}

status() {
    local profile="unknown" turbo temp
    if [ -r "$PROFILE_PATH" ]; then
        profile=$(cat "$PROFILE_PATH")
    fi
    turbo=$(get_turbo_state)
    temp=$(cpu_temp_c)

    printf 'profile=%s\n' "${profile:-unknown}"
    printf 'turbo=%s\n' "$turbo"
    printf 'temp=%sC\n' "${temp:-unknown}"
    printf 'load=%s\n' "$(load_1m)"
    printf 'cpu_bounds_ghz=%s-%s\n' "$CPU_MIN_GHZ" "$CPU_MAX_GHZ"
    printf 'cpu_max_khz=%s\n' "$(cat "${SYSFS_CPU_DIR}/cpu0/cpufreq/scaling_max_freq" 2>/dev/null || echo unknown)"
    printf 'cpu_cur_khz=%s\n' "$(cat "${SYSFS_CPU_DIR}/cpu0/cpufreq/scaling_cur_freq" 2>/dev/null || echo unknown)"
    if command -v undervolt >/dev/null 2>&1; then
        local uv_core=""
        uv_core=$(sudo undervolt --read 2>/dev/null | awk '/^core:/ {print $2, $3}') || uv_core=""
        [ -n "$uv_core" ] && printf 'undervolt_core=%s\n' "$uv_core"
    fi
}

cmd=${1:-}
case "$cmd" in
    [0-9]*|.[0-9]*) set_cpu "$cmd" ;;
    status) status ;;
    cpu) set_cpu "${2:-}" ;;
    undervolt)
        if [ -z "${2:-}" ]; then
            "$(dirname "$0")/undervolt" status
        else
            "$(dirname "$0")/undervolt" cpu "${2:-}" "${3:-}"
        fi
        ;;
    recommend) recommend_cpu ;;
    cool)
        if [ -r "$PROFILE_CHOICES_PATH" ] && grep -qw "low-power" "$PROFILE_CHOICES_PATH"; then
            set_profile low-power
        fi
        if get_turbo_path_and_values >/dev/null 2>&1; then
            set_turbo off
        fi
        set_cpu "$CPU_MIN_GHZ"
        ;;
    balanced)
        if [ -r "$PROFILE_CHOICES_PATH" ] && grep -qw "balanced" "$PROFILE_CHOICES_PATH"; then
            set_profile balanced
        fi
        recommend_cpu
        ;;
    game)
        if [ -r "$PROFILE_CHOICES_PATH" ]; then
            if grep -qw "max-power" "$PROFILE_CHOICES_PATH"; then
                set_profile max-power
            elif grep -qw "performance" "$PROFILE_CHOICES_PATH"; then
                set_profile performance
            fi
        fi
        if get_turbo_path_and_values >/dev/null 2>&1; then
            set_turbo on
        fi
        target_game=$(awk -v max="$CPU_MAX_GHZ" 'BEGIN { t = 4.0; if (t > max) t = max; printf "%.1f", t; }')
        set_cpu "$target_game"
        ;;
    full)
        if [ -r "$PROFILE_CHOICES_PATH" ] && grep -qw "performance" "$PROFILE_CHOICES_PATH"; then
            set_profile performance
        fi
        if get_turbo_path_and_values >/dev/null 2>&1; then
            set_turbo on
        fi
        set_cpu "$CPU_MAX_GHZ"
        ;;
    profile) set_profile "${2:-}" ;;
    turbo) set_turbo "${2:-}" ;;
    -h|--help|help|"") usage ;;
    *) echo "unknown command: $cmd" >&2; usage >&2; exit 2 ;;
esac
